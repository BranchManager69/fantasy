# ESPN authentication (provide either email/password or cookies)
ESPN_EMAIL=your-espn-email@example.com
ESPN_PASSWORD=super-secret-password

# Optional: direct cookie values if already captured
ESPN_S2=
ESPN_SWID=

# League context
ESPN_LEAGUE_ID=123456
ESPN_SEASON=2026

# Runtime options
DATA_ROOT=./data
LOG_LEVEL=INFO

# Next.js uses these when served outside the repository root.
# FANTASY_REPO_ROOT=/absolute/path/to/fantasy
# FANTASY_PYTHON=/absolute/path/to/fantasy/.venv/bin/python

# Optional AI analyst: supply OPENAI_API_KEY in the web process environment.
# Attempts are shared across the league and reset at midnight UTC.
FANTASY_ANALYST_DAILY_LIMIT=6
# Optional writer model; evidence calculation stays independent of this choice.
# FANTASY_ANALYST_MODEL=gpt-6-astra

# Optional private studio. The API key is shared with the analyst, server-side only.
# OPENAI_API_KEY=
# Without this override, a token is generated under DATA_ROOT/private/studio/.
# Use at least 32 characters when setting your own studio access token.
# FANTASY_STUDIO_TOKEN=
# Separate UTC-day attempt limits, each 0 through 20; failed attempts count.
FANTASY_STUDIO_DAILY_LIMIT=20
FANTASY_STUDIO_IMAGE_DAILY_LIMIT=4
# Producer/extractor and editor defaults are independent.
# FANTASY_STUDIO_MODEL=gpt-6-astra
# FANTASY_STUDIO_WRITER_MODEL=gpt-6-astra
# FANTASY_STUDIO_IMAGE_MODEL=gpt-image-2.5-sunburst
